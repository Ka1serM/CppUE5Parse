Checks: >
  -*,
  readability-identifier-naming,
  readability-else-after-return,
  performance-unnecessary-copy-initialization,
  performance-unnecessary-value-param,
  performance-for-range-copy,
  performance-move-const-arg,
  performance-inefficient-vector-operation,
  cppcoreguidelines-no-malloc,
  modernize-make-unique,
  modernize-make-shared
WarningsAsErrors: '*'
HeaderFilterRegex: '.*'
ExcludeHeaderFilterRegex: '/(build-[^/]*|external|ShooterGame)/'
CheckOptions:
  readability-identifier-naming.NamespaceCase: CamelCase
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.UnionCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.EnumConstantCase: CamelCase
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.TypedefCase: CamelCase
  readability-identifier-naming.TemplateParameterCase: CamelCase
  readability-identifier-naming.ConceptCase: CamelCase
  readability-identifier-naming.FunctionCase: camelBack
  readability-identifier-naming.MethodCase: camelBack
  readability-identifier-naming.VariableCase: camelBack
  readability-identifier-naming.ParameterCase: camelBack
  readability-identifier-naming.MemberCase: camelBack
  readability-identifier-naming.NamespaceIgnoredRegexp: '^(ue5parse|runtime|ue)$'
  readability-identifier-naming.FunctionIgnoredRegexp: '^Kraken_Decompress$'
  readability-identifier-naming.ClassIgnoredRegexp: '^USCS_Node$'
  readability-identifier-naming.TypeAliasIgnoredRegexp: '^(is_transparent|is_avalanching)$'
  performance-unnecessary-value-param.AllowedTypes: 'std::stop_token'
