{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 29,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-${presetName}"
    },
    {
      "name": "windows",
      "hidden": true,
      "inherits": "base",
      "description": "llvm-mingw: Clang, libc++ and LLD for Windows, from a Windows or Linux host. Its bin folder is in PATH.",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_SYSTEM_PROCESSOR": "AMD64",
        "CMAKE_C_COMPILER": "x86_64-w64-mingw32-clang",
        "CMAKE_CXX_COMPILER": "x86_64-w64-mingw32-clang++"
      }
    },
    {
      "name": "linux",
      "hidden": true,
      "inherits": "base",
      "description": "Clang with libc++ and LLD.",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "relwithdebinfo",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows Debug",
      "inherits": [
        "windows",
        "debug"
      ]
    },
    {
      "name": "windows-relwithdebinfo",
      "displayName": "Windows RelWithDebInfo",
      "inherits": [
        "windows",
        "relwithdebinfo"
      ]
    },
    {
      "name": "windows-release",
      "displayName": "Windows Release",
      "inherits": [
        "windows",
        "release"
      ]
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug",
      "inherits": [
        "linux",
        "debug"
      ]
    },
    {
      "name": "linux-relwithdebinfo",
      "displayName": "Linux RelWithDebInfo",
      "inherits": [
        "linux",
        "relwithdebinfo"
      ]
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release",
      "inherits": [
        "linux",
        "release"
      ]
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug"
    },
    {
      "name": "windows-relwithdebinfo",
      "configurePreset": "windows-relwithdebinfo"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release"
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-relwithdebinfo",
      "configurePreset": "linux-relwithdebinfo"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-relwithdebinfo",
      "configurePreset": "windows-relwithdebinfo",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-relwithdebinfo",
      "configurePreset": "linux-relwithdebinfo",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "windows-debug",
      "displayName": "Windows Debug",
      "steps": [
        {
          "type": "configure",
          "name": "windows-debug"
        },
        {
          "type": "build",
          "name": "windows-debug"
        },
        {
          "type": "test",
          "name": "windows-debug"
        }
      ]
    },
    {
      "name": "windows-relwithdebinfo",
      "displayName": "Windows RelWithDebInfo",
      "steps": [
        {
          "type": "configure",
          "name": "windows-relwithdebinfo"
        },
        {
          "type": "build",
          "name": "windows-relwithdebinfo"
        },
        {
          "type": "test",
          "name": "windows-relwithdebinfo"
        }
      ]
    },
    {
      "name": "windows-release",
      "displayName": "Windows Release",
      "steps": [
        {
          "type": "configure",
          "name": "windows-release"
        },
        {
          "type": "build",
          "name": "windows-release"
        },
        {
          "type": "test",
          "name": "windows-release"
        }
      ]
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug",
      "steps": [
        {
          "type": "configure",
          "name": "linux-debug"
        },
        {
          "type": "build",
          "name": "linux-debug"
        },
        {
          "type": "test",
          "name": "linux-debug"
        }
      ]
    },
    {
      "name": "linux-relwithdebinfo",
      "displayName": "Linux RelWithDebInfo",
      "steps": [
        {
          "type": "configure",
          "name": "linux-relwithdebinfo"
        },
        {
          "type": "build",
          "name": "linux-relwithdebinfo"
        },
        {
          "type": "test",
          "name": "linux-relwithdebinfo"
        }
      ]
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release",
      "steps": [
        {
          "type": "configure",
          "name": "linux-release"
        },
        {
          "type": "build",
          "name": "linux-release"
        },
        {
          "type": "test",
          "name": "linux-release"
        }
      ]
    }
  ]
}
